        "inputSchema": "{\"type\":\"object\",\"properties\":{\"insights\":{\"type\":\"array\",\"description\":\"3 to 5 core technical insights\",\"items\":{\"type\":\"string\"}},\"linkedin_carousel\":{\"type\":\"array\",\"description\":\"Exactly 8 slides: slide 1 hook, slides 2-7 breakdowns, slide 8 CTA\",\"items\":{\"type\":\"object\",\"properties\":{\"slide\":{\"type\":\"number\"},\"title\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}},\"required\":[\"slide\",\"title\",\"body\"]}},\"twitter_thread\":{\"type\":\"array\",\"description\":\"Exactly 5 tweets forming a technical thread\",\"items\":{\"type\":\"string\"}}},\"required\":[\"insights\",\"linkedin_carousel\",\"twitter_thread\"]}"
